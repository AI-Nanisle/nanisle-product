{
	"name": "nanisle-001-daily-brief",
	"description": "A finite, feedback-aware daily brief: every item is a router to the original source, never a replacement for it",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"check": "tsc -b && vite build && wrangler deploy --dry-run",
		"test": "node --experimental-strip-types --test src/worker/wizard.test.ts src/shared/feedback.test.ts",
		"deploy": "npm run build && wrangler deploy",
		"generate": "node --experimental-strip-types pipeline/generate.ts",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.117.1",
		"aws4fetch": "^1.0.20",
		"fast-xml-parser": "^5.3.4",
		"hono": "4.11.1",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@cloudflare/workers-types": "^5.20260816.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.10.0",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "5.9.3",
		"vite": "^7.0.0",
		"wrangler": "4.123.0"
	}
}
