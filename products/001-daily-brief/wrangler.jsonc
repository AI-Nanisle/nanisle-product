{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nanisle-001-daily-brief",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// SPA fallback swallows *navigation* requests (browser address bar / <a> clicks)
		// before the Worker runs — these routes must hit the Worker: /auth/sso sets the
		// session cookie, /go/* records the click and 302s, /api/* is plain JSON.
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/go/*",
			"/products/daily-brief/*"
		]
	},
	// One KV namespace stores everything: briefs, feedback/click events, note ledgers.
	// Before your first real deploy: `wrangler kv namespace create BRIEFS`
	// and paste the returned id below. Local dev (`npm run dev`) uses an
	// in-memory KV and ignores the id, so mock mode needs no setup.
	"kv_namespaces": [
		{ "binding": "BRIEFS", "id": "f0ca5369ab514bd683679be5156cc68a" }
	],
	// Non-secret configuration. Secrets are NEVER written here or in any file —
	// set them with `wrangler secret put <NAME>` (prod) or in .dev.vars (local, gitignored):
	//   NANISLE_SSO_SECRET   shared with the nanisle main site — readers sign in with their
	//                        nanisle account via SSO handoff (see src/worker/sso.ts)
	//   ACCESS_CODE          admin credential (x-access-code): manual full-run trigger; also a
	//                        reader fallback for self-hosted instances without the main site
	//   AWS_ACCESS_KEY_ID    minimal-permission IAM user `nanisle-daily-brief-worker`:
	//   AWS_SECRET_ACCESS_KEY  DynamoDB table access + invoking the generate Function URL
	//                        (issued/rotated per the runbook in the main repo's infra/README.md)
	//   DEEPSEEK_API_KEY     only for AI_PROVIDER=deepseek (the production default)
	//   ANTHROPIC_API_KEY    only for AI_PROVIDER=anthropic (bring your own key)
	//   AI_GATEWAY_KEY       only for AI_PROVIDER=gateway (virtual key issued by the gateway)
	//   OWNER_AI_EMAILS / OWNER_AI_PROVIDER / OWNER_AI_MODEL / OWNER_FAST_AI_MODEL /
	//   OWNER_AI_GATEWAY_URL / OWNER_AI_GATEWAY_KEY
	//                        站长专线(主仓 backend/docs/01),全部可选;不设 = 没有专线
	"vars": {
		// 生产默认 deepseek;没配 DEEPSEEK_API_KEY 时代码自动落回 mock(fork
		// 零配置照样跑通,误配的实例在 /api/health 与 [mock] 前缀里看得见)
		"AI_PROVIDER": "deepseek",
		// deepseek-chat 已于 2026-07-24 退役;V4 Pro 默认开 thinking(docs/02 §6.1)
		"AI_MODEL": "deepseek-v4-pro",
		// 轻任务档(向导/改稿/口味蒸馏,docs/05 §D):flash 快且省,交互不等 thinking
		"FAST_AI_MODEL": "deepseek-v4-flash",
		"AI_MAX_OUTPUT_TOKENS": "4096",
		"APP_URL": "https://nanisle.com/products/daily-brief",
		// Where the lock screen sends readers to sign in (the main site's launch gate)
		"NANISLE_URL": "https://nanisle.com",
		// N1 · 用户手动加源试抓失败时,实时把这条需求(谁/什么源/为什么失败)
		// 发给开发者。发件走 SES(worker IAM 需 ses:SendEmail,主仓 infra)。
		"EMAIL_FROM": "brief@nanisle.com",
		"DEV_NOTIFY_EMAIL": "panghd0811@gmail.com",
		// AWS side (cdk stack in the main repo's infra/): DynamoDB via aws4fetch, and the
		// generate Lambda's Function URL. Unset AWS credentials => KV fallback store (dev/fork).
		"DDB_TABLE": "nanisle-daily-brief",
		"AWS_REGION": "us-east-1",
		// The generate Lambda's Function URL (the GenerateFunctionUrl output of `cdk deploy`)
		"GENERATE_URL": "https://4zwg2qxwkmwg56rmb5awji4uiq0mibqt.lambda-url.us-east-1.on.aws/"
		// "AI_GATEWAY_URL": "https://your-gateway.example.com"  // AI_PROVIDER=gateway only
	}
}
