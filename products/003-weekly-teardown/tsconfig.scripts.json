{
	// `scripts/` 的类型闸(阶段 9 补)。
	//
	// 为什么它必须存在:scripts/recall-check.ts 是**查全验收**——「发现层能不能
	// 捞回站长手工能找到的东西」,也就是 docs/01 风险 1 的正面回答。它决定的是
	// 方案成不成立,却是全仓唯一一段不过类型闸的代码(阶段 4 修复轮就报过)。
	// 一段没人检查的验收脚本,坏了的表现是「跑出来 0/5」——而那和「发现层真的
	// 退化了」在输出上一模一样,人只会去查发现层。
	//
	// 为什么单独一个项目而不是塞进 tsconfig.worker.json:那个项目的 types 是
	// @cloudflare/workers-types,而这个脚本是拿 node 直接跑的(`node
	// --experimental-strip-types`)。两套全局类型(node 的 fetch/Response vs
	// workers 的)混在一个项目里会互相打架,而它们各自都是对的 —— 分成两个项目
	// 才能让**同一份 src/shared 代码在两个运行时下都被检查一遍**,这反而是好事:
	// github.ts 那个 `Illegal invocation` 的坑就是「node 上对、workerd 上错」。
	//
	// 测试文件仍然不在任何项目里(见 tsconfig.app/worker 的 exclude)。那是另一件
	// 事,记在 docs/02「阶段 9」一节的「还没做」里。
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "ESNext",
		"skipLibCheck": true,

		/* Bundler mode:和别的项目一致,`.ts` 后缀的相对 import 要认 */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"types": ["node"],

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	},
	"include": ["scripts"]
}
