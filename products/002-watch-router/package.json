{
	"name": "nanisle-002-watch-router",
	"description": "AI 帮我看:长视频/播客/文章的判决 + 要点 + 分段地图(nanisle 002)",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"test": "node --experimental-strip-types --test src/shared/ai.test.ts src/shared/subs-guard.test.ts",
		"build": "tsc -b && vite build",
		"check": "tsc -b && vite build && wrangler deploy --dry-run",
		"deploy": "npm run build && wrangler deploy",
		"build:consumer": "esbuild consumer/src/lambda.ts consumer/src/local.ts --bundle --platform=node --format=esm --target=node22 --outdir=consumer/dist --out-extension:.js=.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.117.1",
		"@mozilla/readability": "^0.6.0",
		"aws4fetch": "^1.0.20",
		"defuddle": "^0.19.3",
		"hono": "4.11.1",
		"linkedom": "^0.18.13",
		"react": "19.2.1",
		"react-dom": "19.2.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@cloudflare/workers-types": "^5.20260816.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "5.9.3",
		"vite": "^7.0.0",
		"wrangler": "4.123.0"
	}
}
