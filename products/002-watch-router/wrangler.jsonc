{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nanisle-002-watch-router",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// 订阅模式(docs/05 §3.4):00:00 UTC = 20:00 美东投发现消息(DeepSeek 非高峰、
	// 避开 YouTube RSS 09–12 UTC 的 404 高发段);01:30 UTC 兜底挑选。两条 cron
	// 的字符串是 src/worker/subs.ts 里 DISCOVER_CRON / SWEEP_CRON 的分流依据。
	"triggers": { "crons": ["0 0 * * *", "30 1 * * *"] },
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// SPA fallback swallows *navigation* requests before the Worker runs —
		// these routes must hit the Worker: /auth/sso sets the session cookie,
		// /api/* is plain JSON.
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/products/watch-router/*"
		]
	},
	// KV 只放内容缓存(content:<platform>:<id>,docs/02 T6);有主的状态在
	// DynamoDB(nanisle-watch-router 表,主仓 infra 的 NanisleWatchRouter stack)。
	// Before your first real deploy: `wrangler kv namespace create WATCH`
	// and paste the returned id below. Local dev uses an in-memory KV.
	"kv_namespaces": [
		{ "binding": "WATCH", "id": "f0573f4ff69f4a5098173d8a092459e4" }
	],
	// Non-secret configuration. Secrets are NEVER written here or in any file —
	// set them with `wrangler secret put <NAME>` (prod) or in .dev.vars (local, gitignored):
	//   NANISLE_SSO_SECRET     shared with the nanisle main site (SSO handoff, src/worker/sso.ts)
	//   ACCESS_CODE            admin credential (x-access-code)
	//   CONSUMER_TOKEN         auth for the slow-lane consumer's /api/queue/* callbacks
	//   JINA_KEY               r.jina.ai extraction fallback (fast lane, docs/02 T2)
	//   EMAIL_UNSUB_SECRET     订阅邮件退订 token 的 HMAC 密钥(docs/05 §3.5);不设 = 不发邮件
	//   AWS_ACCESS_KEY_ID      minimal-permission IAM user `nanisle-watch-router-worker`:
	//   AWS_SECRET_ACCESS_KEY    DynamoDB table access + SQS SendMessage
	//   DEEPSEEK_API_KEY       only for AI_PROVIDER=deepseek (the production default)
	//   OWNER_AI_EMAILS / OWNER_AI_PROVIDER / OWNER_AI_MODEL / OWNER_FAST_AI_MODEL /
	//   OWNER_AI_GATEWAY_URL / OWNER_AI_GATEWAY_KEY
	//                          站长专线(主仓 backend/docs/01),全部可选;不设 = 没有专线
	"vars": {
		// 生产默认 deepseek;没配 DEEPSEEK_API_KEY 时代码自动落回 mock(fork
		// 零配置照样跑通,误配的实例在 /api/health 里看得见)
		"AI_PROVIDER": "deepseek",
		// V4 Pro 默认开 thinking;整篇转写一次调用(docs/02 T3),质量优先
		"AI_MODEL": "deepseek-v4-pro",
		// 轻任务档:用户级高亮小调用(docs/02 T4 第二次调用)
		"FAST_AI_MODEL": "deepseek-v4-flash",
		// 32768:V4 Pro 的 thinking 也占输出预算,所以这个数不是「产出能多长」而是
		// 「思考 + 产出一共能多长」。8192 时高密度长文被截断(finish=length);16384
		// 也已经贴着墙——2026-08-31 拿一小时视频实测,completion 用到 14896/16384,
		// 其中 thinking 11812,只剩 9% 余量,思考多绕一圈就越界。抬到 32768(DeepSeek
		// 与 Claude 都收)。用不到不花钱:计费按实际 token,这只是上限。Lambda 侧同值
		"AI_MAX_OUTPUT_TOKENS": "32768",
		"APP_URL": "https://nanisle.com/products/watch-router",
		// 订阅日报发件地址(docs/05 §3.5)。域名身份 nanisle.com 在 001 的 SES 里已验证,同账号直接用
		"EMAIL_FROM": "watch@nanisle.com",
		"NANISLE_URL": "https://nanisle.com",
		// AWS side (NanisleWatchRouter stack in the main repo's infra/):
		// unset AWS credentials => in-memory fallback store (dev/fork).
		"DDB_TABLE": "nanisle-watch-router",
		"AWS_REGION": "us-east-1",
		// The tasks queue (the QueueUrl output of `cdk deploy NanisleWatchRouter`)
		"QUEUE_URL": "https://sqs.us-east-1.amazonaws.com/494347858613/nanisle-watch-router-tasks",
		// 001 的跨产品只读端点(个性化高亮,docs/02 T7②)。必须走 workers.dev
		// 直连域:Worker fetch 回自己 zone(nanisle.com)会被 Cloudflare 以 522
		// 拒掉——同 zone 回环限制,线上实测。配套 secret INTEROP_TOKEN 未设时
		// 高亮整个关闭。
		"INTEROP_TRACKERS_URL": "https://nanisle-001-daily-brief.pang-huadong0811.workers.dev/api/interop/trackers"
	}
}
